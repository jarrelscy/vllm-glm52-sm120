# GLM-5.2 hybrid (NVFP4+AQLM) on SM120 (RTX PRO 6000 Blackwell) with DSpark
# speculative decode under pipeline parallelism.
#
# This image builds THIS fork (vllm-glm52-sm120) from source. The two things that
# make it work are already committed here — no runtime patching:
#   * f961f6d3e  per-expert two-tier NVFP4+AQLM fused MoE (GlmMoeDsa hybrid quant)
#   * f1b9c86bc  DSpark spec-decode under PP: draft-token FIFO to non-last ranks
#
# Weights are NOT baked in (271 GiB). Mount them at /models (see run examples).
#
# Build:
#   docker build -f Dockerfile.glm52-sm120 -t glm52-sm120 .
#
# Run (1M context — PP4, NO speculator; the full-window config, default):
#   docker run --gpus all --ipc=host -p 8001:8001 \
#     -v /path/to/GLM-5.2-NVFP4-AQLM-hybrid:/models/1m:ro \
#     -v $HOME/.cache/huggingface:/root/.cache/huggingface \
#     -e PARALLEL=pp4-1m \
#     glm52-sm120
#
# Run (speculative decode — TP4 + DSpark, ~200K, fastest ~59.6 tok/s):
#   docker run --gpus all --ipc=host -p 8001:8001 \
#     -v /path/to/GLM-5.2-NVFP4-AQLM-hybrid:/models/1m:ro \
#     -e PARALLEL=tp4-dspark glm52-sm120
#
# Run (speculative decode — TP2xPP2 + DSpark, ~223K, ~35 tok/s):
#   docker run --gpus all --ipc=host -p 8001:8001 \
#     -v /path/to/GLM-5.2-NVFP4-AQLM-hybrid:/models/1m:ro \
#     -e PARALLEL=tp2pp2 glm52-sm120
#
# 1M + DSpark is NOT possible on 4x96GB (drafter KV won't co-fit) — see entrypoint.

FROM nvidia/cuda:12.9.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential ninja-build \
    && rm -rf /var/lib/apt/lists/*

# uv + standalone CPython 3.12 (also supplies Python.h for JIT builds)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /opt/vllm
COPY . /opt/vllm

# venv + vLLM from THIS fork's source (patches already committed)
RUN uv venv --python 3.12 .venv \
    && . .venv/bin/activate \
    && uv pip install vllm --torch-backend=auto \
    && VLLM_USE_PRECOMPILED=1 uv pip install -e . --torch-backend=auto \
    && uv pip install ninja "huggingface_hub[cli]"

# flashinfer PINNED to a known-good commit — GLM DSA needs
# kv_scale_format='arbitrary_fp32' for the SM120 sparse-MLA path, which released
# flashinfer wheels lack, so we build from git. flashinfer's `main` is a MOVING
# ref, so pin to 56d538e (the exact commit the shipped inkling + pre-lmcache GLM
# images were gated on). Do NOT float this — bump only after re-gating.
ARG FLASHINFER_COMMIT=56d538ed7ca36ae2b1f60e9865134bf6fa7f5106
RUN . .venv/bin/activate \
    && uv pip install "flashinfer-python @ git+https://github.com/flashinfer-ai/flashinfer.git@${FLASHINFER_COMMIT}"

# --- cutlass-dsl republish guard (GLM crash-loop root cause) ----------------
# ROOT CAUSE of the 2026-07-22 crash-loop: nvidia-cutlass-dsl (a py3-none-any
# wheel pulled transitively by flashinfer) had its 4.5.2 REPUBLISHED on the
# index. The newer 4.5.2's cutlass/cute/experimental/__init__.py does
# `_dsl.CuteExperimentalDSL.jit` — a symbol its own bundled cutlass_dsl lacks on
# CUDA<13.1 — so `import flashinfer.comm` (which imports cute.experimental for a
# registration side-effect) raises a FATAL AttributeError at
# init_model_parallel_group and crash-loops the server. The OLDER good 4.5.2
# shipped that file as a stub raising NotImplementedError, which flashinfer
# TOLERATES (it catches NotImplementedError, NOT AttributeError). The wheel
# cannot be pinned by version (same version string, republished in place) and
# flashinfer vendors its OWN CuTeDSL under flashinfer/data/cutlass for actual
# compute, so the standalone package's core is only touched by this tolerated
# import. Force the stub: index-independent, idempotent, reproduces the gated
# inkling behavior exactly. (See also inkling-sm120's identical guard.)
RUN . .venv/bin/activate \
    && CUTE_EXP=$(python -c "import cutlass,os;print(os.path.join(os.path.dirname(cutlass.__file__),'cute','experimental','__init__.py'))") \
    && printf '%s\n' 'raise NotImplementedError("CuTe Experimental disabled (pinned guard): nvidia-cutlass-dsl 4.5.2 republished with a broken CuteExperimentalDSL ref on CUDA<13.1; flashinfer tolerates this import failure.")' > "$CUTE_EXP" \
    && echo "patched cutlass cute.experimental stub -> $CUTE_EXP"

# SM120 JIT toolchain: pin nvcc/crt/nvvm/cccl to torch's CUDA minor + lib64 link.
# (nvidia is a namespace package -> nvidia.__file__ is None; use the venv path.)
RUN . .venv/bin/activate \
    && TORCH_CU=$(python -c "import torch;v=torch.version.cuda.split('.');print(v[0]+'.'+v[1])") \
    && uv pip install "nvidia-cuda-nvcc==${TORCH_CU}.*" "nvidia-cuda-crt==${TORCH_CU}.*" \
                      "nvidia-nvvm==${TORCH_CU}.*" "nvidia-cuda-cccl==${TORCH_CU}.*" || true \
    && NV="/opt/vllm/.venv/lib/python3.12/site-packages/nvidia" \
    && CUX="$NV/cu13"; [ -d "$CUX" ] || CUX="$NV/cu12" \
    && ln -sfn lib "$CUX/lib64" 2>/dev/null || true \
    && for f in "$CUX"/lib/lib*.so.*; do [ -e "$f" ] || continue; b=$(basename "$f"); s=${b%%.so.*}; \
         [ -e "$CUX/lib/$s.so" ] || ln -s "$b" "$CUX/lib/$s.so"; done

# LMCache (KV-cache offload/persistence to CPU RAM + NVMe disk; opt-in at
# runtime via ENABLE_LMCACHE=1 — see entrypoint). --no-deps on purpose:
# lmcache's dependency list would drag cupy-cuda13x/nixl/transformers/numpy
# pins into the image; sortedcontainers+aiofile+caio are the only imports it
# actually needs on top of what's already here (verified by adapter import).
#
# Installs OUR FORK (github.com/jarrelscy/LMCache, branch glm52-dcp-dsa),
# not upstream pip lmcache==0.5.1: stock lmcache cannot serve this profile
# (DCP4 token-sharded KV -> slot_mapping/token_ids mismatches on every
# save; see /home/jarrelscy/glm52/LMCACHE_PROGRESS.md for the evaluation
# and /home/jarrelscy/glm52/LMCACHE_FORK_PROGRESS.md for the fix). The
# fork is upstream-0.5.1-plus-dev-HEAD-plus-surgical-DCP-patches; pin the
# branch, not a moving ref, so rebuilds are reproducible until this is
# merged upstream and can move back to a released version.
# NOTE: lmcache's setup.py compiles a native `c_ops` CUDA extension via
# torch.utils.cpp_extension.BuildExtension, which hard-fails with a CUDA
# major-version mismatch (base image nvcc=12.9 vs torch.version.cuda=13.0 --
# vLLM's --torch-backend=auto pulls a cu130 build) unless CUDA_HOME points
# at a toolchain matching torch's CUDA version. Reuse the SAME pip-installed
# nvcc/crt/nvvm/cccl toolchain (already installed above for the SM120 JIT
# toolchain) instead of the base image's system CUDA.
# LMCACHE_CACHEBUST: bump via --build-arg during active fork development
# to force a fresh `git+https://...@glm52-dcp-dsa` checkout instead of
# reusing a stale cached layer (the branch ref is a moving target while
# the fork is being fixed up; docker's layer cache is keyed on this
# RUN's literal text, not on upstream repo state). Bump this default
# whenever a new fork commit must be baked in so that plain rebuilds
# (switch.sh, `compose up --build`) pick up the fixed lmcache instead of
# reusing a stale cached layer. Current: 89840cfa (retrieve/lookup
# double-unpin deadlock fix on save_only_first_rank / DCP retrieve path).
ARG LMCACHE_CACHEBUST=89840cfa
RUN . .venv/bin/activate \
    && NV="/opt/vllm/.venv/lib/python3.12/site-packages/nvidia" \
    && CUX="$NV/cu13"; [ -d "$CUX" ] || CUX="$NV/cu12" \
    && export CUDA_HOME="$CUX" PATH="$CUX/bin:$PATH" \
    && export TORCH_CUDA_ARCH_LIST="12.0" \
    && echo "lmcache cachebust=${LMCACHE_CACHEBUST}" \
    && uv pip install --no-deps sortedcontainers aiofile caio \
    && uv pip install --no-deps \
         "lmcache @ git+https://github.com/jarrelscy/LMCache.git@glm52-dcp-dsa"

# Locate the CPython include dir (Python.h) and the nvidia CUDA home for JIT
ENV PYINC=/root/.local/share/uv/python
ENV FLASHINFER_DISABLE_VERSION_CHECK=1
ENV NCCL_MAX_NCHANNELS=4 NCCL_BUFFSIZE=1048576
ENV VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
ENV VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
ENV VLLM_DISABLE_FP8_W8A16=1

# Runtime knobs (override with -e):
#   MODEL_DIR    path to mounted weights          (default /models/1m)
#   PARALLEL     serving topology                 (default pp4-1m)
#                  pp4-1m      PP4, no spec, 1M window        (KV 1.27M tok, ~22 tok/s)
#                  tp2pp2      TP2xPP2 + DSpark, ~223K        (~35 tok/s)
#                  tp4-dspark  TP4 + DSpark, ~200K            (~59.6 tok/s, fastest)
#                  pp4-dspark  PP4 + DSpark, ~130K            (dominated by tp2pp2)
#   MAXLEN       max model len                    (per-mode default)
#   NUM_SPEC     speculative tokens               (unset -> per-mode default: MTP=2, DSpark=5)
#   DRAFT_MAXLEN cap drafter KV window (optional; does NOT enable 1M+spec)
# NOTE: 1M context and DSpark cannot co-fit on 4x96GB — use pp4-1m for 1M,
#       tp4-dspark/tp2pp2 for speculative decode at <=~200K.
# NUM_SPEC is intentionally NOT set here: baking it would defeat the entrypoint's
# per-mode default (it can't tell an image default from a user override). Set -e NUM_SPEC=N to override.
ENV MODEL_DIR=/models/1m PARALLEL=tp4-1m-mtp

COPY docker-entrypoint.glm52.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
EXPOSE 8001
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
