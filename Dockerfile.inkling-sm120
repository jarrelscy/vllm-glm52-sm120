# Inkling-512k-NVFP4-AQLM-hybrid on SM120 (RTX PRO 6000 Blackwell, TP4).
#
# Builds THIS fork (feature/inkling) from source. Everything Inkling needs is
# committed in-tree: the NVFP4+AQLM hybrid MoE quant + fused gemv/grouped
# kernels, Triton split-KV decode / varlen prefill / virtual-seq verify
# attention (rel-bias, paged, SWA), sconv/SWA conv-state cache, restored MTP
# multi-prefill speculator, FULL_DECODE_ONLY graph support.
#
# Weights are NOT baked in. Mount the HF snapshot at /models/inkling:
#
# Build:
#   docker build -f Dockerfile.inkling-sm120 -t inkling-sm120 .
#
# Run (default: 512K context + MTP ns=2 — the speed config):
#   docker run --gpus all --ipc=host -p 8001:8001 \
#     -v /data/huggingface/hub/models--jarrelscy--Inkling-512k-NVFP4-AQLM-hybrid/snapshots/<rev>:/models/inkling:ro \
#     inkling-sm120
#
# Run (640K context, no MTP — the long-context config):
#   docker run --gpus all --ipc=host -p 8001:8001 \
#     -v .../snapshots/<rev>:/models/inkling:ro -e MODE=640k inkling-sm120

FROM nvidia/cuda:12.9.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential ninja-build libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# uv + standalone CPython 3.12 (also supplies Python.h for JIT builds)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /opt/vllm
COPY . /opt/vllm

# venv + vLLM from THIS fork's source
RUN uv venv --python 3.12 .venv \
    && . .venv/bin/activate \
    && uv pip install vllm --torch-backend=auto \
    && VLLM_USE_PRECOMPILED=1 uv pip install -e . --torch-backend=auto \
    && uv pip install ninja "huggingface_hub[cli]" soundfile librosa

# flashinfer PINNED to the commit this config was gated on. flashinfer `main` is
# a MOVING ref: newer HEADs (e.g. 7f786be) import cutlass.cutlass_dsl.
# CuteExperimentalDSL, absent in nvidia-cutlass-dsl 4.5.2 on CUDA<13.1, which
# fatally AttributeErrors at `import flashinfer.comm`. 56d538e is the exact main
# HEAD the shipped inkling image was built and gated on. Do NOT float this ref.
ARG FLASHINFER_COMMIT=56d538ed7ca36ae2b1f60e9865134bf6fa7f5106
RUN . .venv/bin/activate \
    && uv pip install "flashinfer-python @ git+https://github.com/flashinfer-ai/flashinfer.git@${FLASHINFER_COMMIT}"

# --- cutlass-dsl republish guard --------------------------------------------
# nvidia-cutlass-dsl (py3-none-any, pulled transitively by flashinfer) had its
# 4.5.2 REPUBLISHED on the index: the newer 4.5.2's
# cutlass/cute/experimental/__init__.py does `_dsl.CuteExperimentalDSL.jit`, a
# symbol absent from its own cutlass_dsl on CUDA<13.1 -> fatal AttributeError at
# `import flashinfer.comm`. This image was gated on the OLDER good 4.5.2 whose
# experimental/__init__.py is a NotImplementedError stub (flashinfer tolerates
# it; it does NOT tolerate AttributeError). The wheel can't be pinned by version
# (republished in place) and flashinfer vendors its own CuTeDSL for compute, so
# force the stub to make rebuilds index-independent. Matches glm52-sm120.
RUN . .venv/bin/activate \
    && CUTE_EXP=$(python -c "import cutlass,os;print(os.path.join(os.path.dirname(cutlass.__file__),'cute','experimental','__init__.py'))") \
    && printf '%s\n' 'raise NotImplementedError("CuTe Experimental disabled (pinned guard): nvidia-cutlass-dsl 4.5.2 republished with a broken CuteExperimentalDSL ref on CUDA<13.1; flashinfer tolerates this import failure.")' > "$CUTE_EXP" \
    && echo "patched cutlass cute.experimental stub -> $CUTE_EXP"

# SM120 JIT toolchain: pin nvcc/crt/nvvm/cccl to torch's CUDA minor + lib64
# link. (nvidia is a namespace package -> use the venv path, not __file__.)
RUN . .venv/bin/activate \
    && TORCH_CU=$(python -c "import torch;v=torch.version.cuda.split('.');print(v[0]+'.'+v[1])") \
    && uv pip install "nvidia-cuda-nvcc==${TORCH_CU}.*" "nvidia-cuda-crt==${TORCH_CU}.*" \
                      "nvidia-nvvm==${TORCH_CU}.*" "nvidia-cuda-cccl==${TORCH_CU}.*" || true \
    && NV="/opt/vllm/.venv/lib/python3.12/site-packages/nvidia" \
    && CUX="$NV/cu13"; [ -d "$CUX" ] || CUX="$NV/cu12" \
    && ln -sfn lib "$CUX/lib64" 2>/dev/null || true \
    && for f in "$CUX"/lib/lib*.so.*; do [ -e "$f" ] || continue; b=$(basename "$f"); s=${b%%.so.*}; \
         [ -e "$CUX/lib/$s.so" ] || ln -s "$b" "$CUX/lib/$s.so"; done

ENV PYINC=/root/.local/share/uv/python
ENV FLASHINFER_DISABLE_VERSION_CHECK=1

# LMCache KV persistence (task #143), opt-in via ENABLE_LMCACHE=1 at runtime.
# Installs the SM120-hybrid fork (jarrelscy/LMCache branch inkling-mp-hybrid,
# pinned to the SWA whole-chunk-skip commit) that adds the MP connector + the
# per-object-group sliding-window trim making >=512K restore lossless.
#
# The native_storage_ops CUDA/C++ extension MUST be built: the MP server hard-
# imports it (storage_manager.py: `from lmcache.native_storage_ops import ...`,
# no pure-Python fallback), and ENABLE_LMCACHE=1 launches that MP server. Build
# against the venv's cu130 torch via --no-build-isolation (pyproject recommends
# this to keep the torch version flexible) with the cu13 nvcc on PATH so torch's
# CUDA-version check matches (the base image's /usr/local/cuda is 12.9 and would
# fail against cu130 torch). LMCACHE_CUDA_MAJOR + ENABLE_CXX11_ABI are derived to
# match. Deps (cupy-cuda13x, pyzmq, sortedcontainers, aiofile, opentelemetry-*,
# msgspec, ...) resolve automatically from the fork's metadata.
RUN . .venv/bin/activate \
    && uv pip install ninja "packaging>=24.2" "setuptools>=77.0.3,<81.0.0" \
                      "setuptools_scm>=8" wheel \
    && NV="/opt/vllm/.venv/lib/python3.12/site-packages/nvidia" \
    && CUX="$NV/cu13"; [ -d "$CUX" ] || CUX="$NV/cu12" \
    && export CUDA_HOME="$CUX" PATH="$CUX/bin:$PATH" \
    && export LMCACHE_CUDA_MAJOR="$(basename "$CUX" | tr -dc 0-9 | cut -c1-2)" \
    && export ENABLE_CXX11_ABI=1 \
    && export TORCH_CUDA_ARCH_LIST="12.0+PTX" \
    && nvcc --version | tail -2 \
    && uv pip install --no-build-isolation \
       "lmcache @ git+https://github.com/jarrelscy/LMCache.git@fbec1c14"

# Runtime knobs (override with -e): MODEL_DIR, MODE (512k-mtp|640k), MAXLEN,
# NUM_SPEC (512k-mtp only, default 2 = the swept optimum). See entrypoint.
ENV MODEL_DIR=/models/inkling MODE=512k-mtp

COPY docker-entrypoint.inkling.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
EXPOSE 8001
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
