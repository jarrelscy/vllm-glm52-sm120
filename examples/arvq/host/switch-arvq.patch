@@ -288,0 +290 @@
+    echo "    glm5.3-arvq             GLM-5.3 Vision ARVQ hybrid + dense P4, TP4+DCP4+MTP3, 1,048,576-token ctx, eight request slots, LMCache; see model card for measured decode throughput"
@@ -307,0 +310,19 @@
+
+# Use the measured ARVQ deployment for the existing 1M hybrid profile. Validate
+# its local inputs before stopping the currently serving model. Other profiles
+# continue to use the base compose file; the older AQLM hybrid remains available
+# as glm5.3-hybrid. Rotation has not been converted into this full checkpoint.
+if [ "$1" = "glm5.3-hybrid-1m" ]; then
+  ARVQ_COMPOSE="$SCRIPT_DIR/docker-compose.glm53-arvq.yaml"
+  ARVQ_MODEL="/data/models/jarrelscy/GLM-5.3-Vision-NVFP4-ARVQ-hybrid"
+  if [ ! -f "$ARVQ_COMPOSE" ] || [ ! -f /home/jarrelscy/glm52/vllm-arvq-serving/Dockerfile.arvq ]; then
+    echo "ERROR: ARVQ compose override or vllm-arvq-serving build source is missing." >&2
+    exit 1
+  fi
+  if ! _shards_complete "$ARVQ_MODEL"; then
+    echo "ERROR: ARVQ checkpoint is incomplete at $ARVQ_MODEL; keeping the current server running." >&2
+    exit 1
+  fi
+  export COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yaml:$ARVQ_COMPOSE"
+  docker compose --profile glm5.3-hybrid-1m config --quiet
+fi
